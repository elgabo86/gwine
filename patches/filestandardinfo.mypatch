diff --git a/server/fd.c b/server/fd.c
index aa71e6d..833cc08 100644
--- a/server/fd.c
+++ b/server/fd.c
@@ -2718,6 +2718,32 @@ void default_fd_get_file_info( struct fd *fd, obj_handle_t handle, unsigned int
         }
         else set_error( STATUS_OBJECT_TYPE_MISMATCH );
         break;
+    case FileStandardInformation:
+        {
+            FILE_STANDARD_INFORMATION info;
+            struct stat st;
+
+            if (get_reply_max_size() < sizeof(info))
+            {
+                set_error( STATUS_INFO_LENGTH_MISMATCH );
+                return;
+            }
+
+            if (fd->unix_fd != -1 && !fstat( fd->unix_fd, &st ))
+            {
+                info.AllocationSize.QuadPart = st.st_blksize ? (LONGLONG)st.st_blocks * 512 : st.st_size;
+                info.EndOfFile.QuadPart = st.st_size;
+                info.NumberOfLinks = st.st_nlink;
+                info.DeletePending = FALSE;
+                info.Directory = S_ISDIR(st.st_mode);
+            }
+            else
+            {
+                memset( &info, 0, sizeof(info) );
+            }
+            set_reply_data( &info, sizeof(info) );
+            break;
+        }
     default:
         set_error( STATUS_NOT_IMPLEMENTED );
     }
